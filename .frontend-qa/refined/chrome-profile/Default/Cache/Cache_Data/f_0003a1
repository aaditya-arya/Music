    /* Mega Dropdown CSS with Invisible Hover Bridge & Smooth Transition */
    .mega-dropdown-menu {
      background-color: #ffffff !important;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transform: translateX(-50%) translateY(8px);
      transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.25s;
    }
    .mega-dropdown-menu::before {
      content: '';
      position: absolute;
      top: -24px;
      left: 0;
      right: 0;
      height: 24px;
    }
    .nav-item-dropdown:hover .mega-dropdown-menu,
    .mega-dropdown-menu:hover,
    .mega-dropdown-menu.is-open {
      visibility: visible !important;
      opacity: 1 !important;
      transform: translateX(-50%) translateY(0) !important;
      pointer-events: auto !important;
    }
    
    /* Interactive Card Reveal & Clickable Quick-view */
    .card-reveal .card-content {
      transform: translateY(16px);
      transition: all 0.4s ease;
    }
    .card-reveal:hover .card-content {
      transform: translateY(0);
    }
    .card-reveal .card-overlay {
      background: linear-gradient(to top, rgba(11, 22, 51, 0.95), rgba(11, 22, 51, 0.35));
      transition: all 0.4s ease;
    }
    .card-reveal:hover .card-overlay {
      background: linear-gradient(to top, rgba(11, 22, 51, 0.98), rgba(241, 104, 38, 0.75));
    }

    /* Scroll-triggered Heading Accent Line (Smooth Left-to-Right sweep across words, then settles comfortably) */
    .heading-line-track {
      position: relative;
      overflow: hidden;
      width: 100%;
      height: 4px;
      border-radius: 9999px;
      background: rgba(226, 232, 240, 0.5);
    }

    .section-accent-line {
      position: absolute;
      top: 0;
      left: 0;
      width: 60px;
      height: 100%;
      background-color: #f16826;
      border-radius: 9999px;
      opacity: 0;
    }

    .section-accent-line.line-animated {
      animation: lineTravelAndSettle 2.5s cubic-bezier(0.25, 1, 0.35, 1) forwards;
    }

    .track-center .section-accent-line.line-animated {
      animation: lineTravelAndSettleCenter 2.5s cubic-bezier(0.25, 1, 0.35, 1) forwards;
    }

    @keyframes lineTravelAndSettle {
      0% {
        left: -70px;
        opacity: 1;
      }
      44% {
        left: 100%;
        opacity: 1;
      }
      45% {
        left: -70px;
        opacity: 0;
      }
      48% {
        left: -70px;
        opacity: 1;
      }
      100% {
        left: 0px;
        opacity: 1;
      }
    }

    @keyframes lineTravelAndSettleCenter {
      0% {
        left: -70px;
        opacity: 1;
      }
      44% {
        left: 100%;
        opacity: 1;
      }
      45% {
        left: -70px;
        opacity: 0;
      }
      48% {
        left: -70px;
        opacity: 1;
      }
      100% {
        left: calc(50% - 30px);
        opacity: 1;
      }
    }

    /* Service Card Target Highlight (Circular Border Trace & Fade Down) */
    .service-card-target {
      scroll-margin-top: 7rem;
      position: relative;
    }

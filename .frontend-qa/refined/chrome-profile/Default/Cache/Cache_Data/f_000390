    .modal-backdrop {
      background-color: rgba(11, 22, 51, 0.78);
      backdrop-filter: blur(6px);
    }

    /* High-Impact Left-to-Right Button Slide Animations */
    .btn-premium-orange {
      background-color: #f16826;
      transition: background-color 0.35s ease, box-shadow 0.35s ease, transform 0.2s ease;
      color: #ffffff;
      cursor: pointer;
    }
    .btn-premium-orange:hover {
      background-color: #1b3574;
      box-shadow: 0 10px 20px -5px rgba(27, 53, 116, 0.4);
    }

    .btn-premium-blue {
      background-color: #1b3574;
      transition: background-color 0.35s ease, box-shadow 0.35s ease, transform 0.2s ease;
      color: #ffffff;
      cursor: pointer;
    }
    .btn-premium-blue:hover {
      background-color: #f16826;
      box-shadow: 0 10px 20px -5px rgba(241, 104, 38, 0.4);
    }

    /* Dual-Color Left-to-Right Text Slide (Corporate Navy -> Flash of Crisp White -> Brand Orange) */
    .text-slide-dual {
      background: linear-gradient(90deg, #1b3574 0%, #1b3574 38%, #ffffff 46%, #f16826 56%, #f16826 100%);
      background-size: 270% 100%;
      background-position: 100% 0;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      transition: background-position 0.65s cubic-bezier(0.25, 1, 0.5, 1);
      display: inline-block;
    }
    .text-slide-dual:hover {
      background-position: 0 0;
    }

    /* Dual-Color Footer Text Slide (Slate Gray -> Crisp White -> Brand Orange) */
    .text-slide-footer {
      background: linear-gradient(90deg, #f16826 0%, #ffffff 40%, #cbd5e1 54%, #94a3b8 100%);
      background-size: 270% 100%;
      background-position: 100% 0;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      transition: background-position 0.65s cubic-bezier(0.25, 1, 0.5, 1);
      display: inline-block;
    }
    .text-slide-footer:hover {
      background-position: 0 0;
    }

    /* Mega Dropdown CSS with Invisible Hover Bridge & Smooth Transition */
    .mega-dropdown-menu {
      background-color: #ffffff !important;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transform: translateX(-50%) translateY(8px);
      transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.25s;
    }
    .mega-dropdown-menu::before {
      content: '';
      position: absolute;
      top: -24px;
      left: 0;
      right: 0;
      height: 24px;
    }
    .nav-item-dropdown:hover .mega-dropdown-menu,
    .mega-dropdown-menu:hover,
    .mega-dropdown-menu.is-open {
      visibility: visible !important;
      opacity: 1 !important;
      transform: translateX(-50%) translateY(0) !important;
      pointer-events: auto !important;
    }
    
    /* Core Service 50% Slide-Up Drawer on Hover (Slow & Subtle Gliding Transition) */
    .service-slide-card {
      position: relative;
      overflow: hidden;
      border-radius: 1rem;
      transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.75s ease, border-color 0.75s ease;
      background-color: #f1f5f9;
    }
    .service-slide-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 10px 10px -5px rgba(0, 0, 0, 0.05);
      border-color: rgba(241, 104, 38, 0.4);
    }
    .service-card-drawer {
      transform: translateY(calc(100% - 78px));
      transition: transform 0.95s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.75s ease;
      max-height: 55%;
      background-color: #ffffff !important;
      border-top: 1px solid #e2e8f0;
      box-shadow: 0 -4px 15px rgba(0, 0, 0, 0.06);
    }
    .service-slide-card:hover .service-card-drawer {
      transform: translateY(0);
      box-shadow: 0 -12px 25px -5px rgba(0, 0, 0, 0.12);
    }
    .service-card-title {
      color: #11224d;
      transition: color 0.5s ease;
    }
    .service-slide-card:hover .service-card-title {
      color: #f16826;
    }
    .service-drawer-desc {
      opacity: 0;
      transition: opacity 0.8s ease 0.3s;
    }
    .service-slide-card:hover .service-drawer-desc {
      opacity: 1;
    }
    .service-card-desc-text {
      color: #475569;
    }
    .service-card-divider {
      border-color: #e2e8f0;
    }

    /* Scroll-triggered Heading Accent Line (Smooth Left-to-Right sweep across words, then settles comfortably) */
    .heading-line-track {
      position: relative;
      overflow: hidden;
      width: 100%;
      height: 4px;
      border-radius: 9999px;
      background: rgba(226, 232, 240, 0.5);
    }

    .section-accent-line {
      position: absolute;
      top: 0;
      left: 0;
      width: 60px;
      height: 100%;
      background-color: #f16826;
      border-radius: 9999px;
      opacity: 0;
    }

    .section-accent-line.line-animated {
      animation: lineTravelAndSettle 2.5s cubic-bezier(0.25, 1, 0.35, 1) forwards;
    }

    .track-center .section-accent-line.line-animated {
      animation: lineTravelAndSettleCenter 2.5s cubic-bezier(0.25, 1, 0.35, 1) forwards;
    }

    @keyframes lineTravelAndSettle {
      0% {
        left: -70px;
        opacity: 1;
      }
      44% {
        left: 100%;
        opacity: 1;
      }
      45% {
        left: -70px;
        opacity: 0;
      }
      48% {
        left: -70px;
        opacity: 1;
      }
      100% {
        left: 0px;
        opacity: 1;
      }
    }

    @keyframes lineTravelAndSettleCenter {
      0% {
        left: -70px;
        opacity: 1;
      }
      44% {
        left: 100%;
        opacity: 1;
      }
      45% {
        left: -70px;
        opacity: 0;
      }
      48% {
        left: -70px;
        opacity: 1;
      }
      100% {
        left: calc(50% - 30px);
        opacity: 1;
      }
    }

    /* Service Card Target Highlight (Circular Border Trace & Fade Down) */
    .service-card-target {
      scroll-margin-top: 7rem;

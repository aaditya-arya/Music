<!-- JavaScript Interaction Logic -->
  <script>
    // Modal Helpers
    function openModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.remove('hidden');
    }
    function closeModal(id) {
      const el = document.getElementById(id);
      if (el) el.classList.add('hidden');
    }

    // Document Verification Simulation
    function simulateVerification() {
      const input = document.getElementById('docIdInput').value.trim();
      const result = document.getElementById('verificationResult');
      if (!input) {
        alert('Please enter a certificate or report number.');
        return;
      }
      result.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'bg-emerald-50', 'text-emerald-700');
      result.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
      result.innerHTML = '&#10003; Authentic Record Found: Certificate #' + input + ' verified under ISO/IEC 17020 Type-A Body accreditation.';
    }

    // Mobile menu toggle
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (mobileBtn && mobileMenu) {
      mobileBtn.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
      });
    }

    // Job selection helper from card to form
    function selectJobAndScroll(jobTitle) {
      const select = document.getElementById('cand_role');
      if (select) {
        select.value = jobTitle;
      }
      const form = document.getElementById('applyForm');
      if (form) {
        form.scrollIntoView({ behavior: 'smooth' });
      }
    }

    // File label updater
    function updateFileName(input) {
      const label = document.getElementById('file_label');
      if (input.files && input.files[0]) {
        label.innerText = 'Selected: ' + input.files[0].name;
        label.classList.add('text-brand-orange');
      }
    }

    // Form submit handler
    async function handleCareerSubmit(e) {
      e.preventDefault();
      const form = document.getElementById('careerApplicationForm');
      const submitBtn = form.querySelector('button[type="submit"]');
      const name = document.getElementById('cand_name').value;
      const email = document.getElementById('cand_email').value;
      const phone = document.getElementById('cand_phone').value;
      const location = document.getElementById('cand_location').value;
      const role = document.getElementById('cand_role').value;
      const experience = document.getElementById('cand_exp').value;
      const notice = document.getElementById('cand_notice').value;
      const qualification = document.getElementById('cand_degree').value;
      const summary = document.getElementById('cand_summary').value;
      
      const certCheckboxes = form.querySelectorAll('input[name="certs"]:checked');
      const certifications = Array.from(certCheckboxes).map(cb => cb.value);

      const resumeInput = document.getElementById('cand_resume');
      const resumeFile = resumeInput && resumeInput.files ? resumeInput.files[0] : null;

      const applicantData = {
        name,
        email,
        phone,
        location,
        role,
        experience,
        qualification,
        certifications,
        notice,
        summary
      };

      if (window.AesSupabase && window.AesSupabase.submitCareerApplication) {
        await window.AesSupabase.submitCareerApplication(applicantData, resumeFile, submitBtn);
      } else {
        alert(`Thank you, ${name}! Your application for "${role}" has been successfully submitted to the HR Engineering Desk.`);
      }

      form.reset();
      const label = document.getElementById('file_label');
      if (label) {
        label.innerText = 'Click or Drag & Drop to upload Resume / CV';
        label.classList.remove('text-brand-orange');
      }
    }
  </script>


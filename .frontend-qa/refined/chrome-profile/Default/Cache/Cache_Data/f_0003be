        // Toggle Collapsible Feedback Hub Form
    function toggleFeedbackHub() {
      var collapse = document.getElementById('feedbackFormCollapse');
      var btnText = document.getElementById('feedbackToggleBtnText');
      var arrow = document.getElementById('feedbackToggleArrow');
      if (collapse) {
        if (collapse.classList.contains('hidden')) {
          collapse.classList.remove('hidden');
          if (btnText) btnText.textContent = 'Hide Update & Feedback Form';
          if (arrow) {
            arrow.innerHTML = '&darr;';
            arrow.classList.remove('group-hover:translate-x-1.5');
            arrow.classList.add('group-hover:translate-y-1');
          }
        } else {
          collapse.classList.add('hidden');
          if (btnText) btnText.textContent = 'Open Update & Feedback Form';
          if (arrow) {
            arrow.innerHTML = '&rarr;';
            arrow.classList.remove('group-hover:translate-y-1');
            arrow.classList.add('group-hover:translate-x-1.5');
          }
        }
      }
    }

    function openFeedbackHubAndScroll() {
      var collapse = document.getElementById('feedbackFormCollapse');
      var btnText = document.getElementById('feedbackToggleBtnText');
      var arrow = document.getElementById('feedbackToggleArrow');
      if (collapse && collapse.classList.contains('hidden')) {
        collapse.classList.remove('hidden');
        if (btnText) btnText.textContent = 'Hide Update & Feedback Form';
        if (arrow) {
          arrow.innerHTML = '&darr;';
          arrow.classList.remove('group-hover:translate-x-1.5');
          arrow.classList.add('group-hover:translate-y-1');
        }
      }
      var target = document.getElementById('feedbackHub');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function selectReason(key) {
      var data = reasonsData[key] || reasonsData['inquiry'];
      
      // Update active pills
      var pills = document.querySelectorAll('.reason-pill');
      pills.forEach(function(p) { p.classList.remove('active'); });
      var activePill = document.getElementById('pill-' + key);
      if (activePill) activePill.classList.add('active');

      // Update hidden input
      document.getElementById('selectedReasonInput').value = data.title;

      // Update button text
      document.getElementById('formSubmitBtn').textContent = data.btnText;

      // Update labels & placeholders
      document.getElementById('messageLabel').textContent = data.messageLabel;
      document.getElementById('messageTextarea').placeholder = data.messagePlaceholder;

      // Update dynamic fields
      document.getElementById('dynamicFormFields').innerHTML = data.html;
    }

